{#- Makros fuer die Ansicht "Pakete".
    Einbinden mit: {% from 'pakete.jinja' import aktiv, held, ... %}
    Nach Aenderungen: Aktion homeassistant.reload_custom_templates ausfuehren.
    Hinweis: Die Markdown-Karte entfernt class-Attribute. Das Styling der Karten haengt deshalb an der
    HTML-Struktur (Reihenfolge der Elemente) und am Status-Icon, nicht an den Klassennamen hier. -#}

{#- Status: [Text, Icon, Farbe, Fortschritt 1-4]. Farbe und Fortschritt setzt das CSS der Karte anhand des Icons. -#}
{%- set status_meta = {
  'registered': ['Angekündigt', 'mdi:tag-outline', 'grau', 1],
  'in_transit': ['Unterwegs', 'mdi:truck-fast-outline', 'blau', 2],
  'out_for_delivery': ['In Zustellung', 'mdi:truck-delivery', 'orange', 3],
  'at_pickup_point': ['Abholbereit', 'mdi:storefront-outline', 'lila', 3],
  'delivered': ['Zugestellt', 'mdi:check-circle', 'gruen', 4],
  'returning': ['Rücksendung', 'mdi:keyboard-return', 'rot', 2],
  'problem': ['Problem', 'mdi:alert-circle', 'rot', 2],
  'unknown': ['Unbekannt', 'mdi:help-circle-outline', 'grau', 1]
} -%}

{#- Reihenfolge in der Liste der aktiven Sendungen -#}
{%- set status_prio = {
  'out_for_delivery': 0, 'at_pickup_point': 1, 'problem': 2, 'in_transit': 3,
  'returning': 4, 'registered': 5, 'unknown': 6
} -%}

{%- set agg = 'sensor.parcel_aggregator_' -%}

