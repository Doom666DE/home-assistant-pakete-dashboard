    'name': 'DPD',
    'ein': ['sensor.dpd_germany_eingehende_pakete'],
    'shop': ['sensor.dpd_germany_unterwegs_zum_parcelshop'],
    'abhol': ['sensor.dpd_germany_abholbereit'],
    'zu': ['sensor.dpd_germany_zugestellte_pakete'],
    'aus': ['sensor.dpd_germany_ausgehende_pakete'],
    'an': ['sensor.dpd_germany_ausgehende_zugestellte_pakete'],
    'stand': ['sensor.dpd_germany_letzte_erfolgreiche_aktualisierung']
  },
  'gls': {
    'name': 'GLS',
    'ein': ['sensor.gls_germany_eingehende_pakete'],
    'shop': ['sensor.gls_germany_unterwegs_zum_parcelshop'],
    'abhol': ['sensor.gls_germany_abholbereit'],
    'zu': ['sensor.gls_germany_zugestellte_pakete'],
    'aus': [],
    'stand': ['sensor.gls_germany_letzte_erfolgreiche_aktualisierung']
  },
  'hermes': {
    'name': 'HERMES',
    'ein': ['sensor.hermes_germany_eingehende_pakete', 'sensor.hermes_germany_manuell_eingehende_pakete'],
    'shop': [],
    'abhol': ['sensor.hermes_germany_abholbereit', 'sensor.hermes_germany_manuell_abholbereit'],
    'zu': ['sensor.hermes_germany_zugestellte_pakete', 'sensor.hermes_germany_manuell_zugestellte_pakete'],
    'aus': [],
    'stand': ['sensor.hermes_germany_letzte_erfolgreiche_aktualisierung', 'sensor.hermes_germany_manuell_letzte_erfolgreiche_aktualisierung']
  },
  'ups': {
    'name': 'UPS',
    'ein': ['sensor.ups_germany_incoming_parcels'],
    'shop': [],
