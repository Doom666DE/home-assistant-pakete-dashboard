    'stand': ['sensor.amazon_germany_letzte_erfolgreiche_aktualisierung']
  },
  'dhl': {
    'name': 'DHL',
    'ein': ['sensor.dhl_germany_eingehende_pakete'],
    'shop': [],
    'abhol': ['sensor.dhl_germany_abholbereit'],
    'zu': ['sensor.dhl_germany_zugestellte_pakete'],
    'aus': ['sensor.dhl_germany_ausgehende_pakete'],
    'an': ['sensor.dhl_germany_ausgehende_zugestellte_pakete'],
    'stand': ['sensor.dhl_germany_letzte_erfolgreiche_aktualisierung']
